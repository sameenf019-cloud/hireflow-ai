# Required
GROQ_API_KEY=your_groq_key_here

# Google (mock mode is on by default; set to false only with real credentials)
GOOGLE_MOCK_MODE=true
RECRUITER_EMAIL=
CALENDAR_ID=primary
TIMEZONE=UTC
INTERVIEW_DURATION_MINUTES=30

# Optional: time zone given to the Scheduling agent (defaults to TIMEZONE)
INTERVIEW_TIMEZONE=

# Optional: screening / email wording
SHORTLIST_THRESHOLD=70
COMPANY_NAME=our team

# Optional: remote Qdrant (leave empty to use local embedded storage)
QDRANT_URL=
QDRANT_API_KEY=

# Optional: CORS (frontend origin)
CORS_ORIGINS=http://localhost:3000